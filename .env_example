# Before first run execute: ./deploy.sh (or sudo ./deploy.sh to create ipset sets)
#
# --- Common (used by both scripts) ---

# DNS name to resolve (host to track)
DNS_RECORD="example.example.com"

# Host name for logs and notifications (e.g. Telegram)
host="my-server"

# Path to message script (relative to script dir or absolute; deploy will rewrite to installed path)
TGBOT="./send_tg.sh"

# --- send_tg.sh (Telegram) ---

# Telegram bot token (from @BotFather)
TG_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Telegram chat ID (where to send messages)
TG_CHAT_ID="-1001234567890"

# --- add_ip_to_ipset.sh ---

# Log file path (relative to script dir or absolute)
IPSET_LOGFILE="./ipset_update.log"

# Ipset set names, space-separated (e.g. ssh_allow ipaudio)
IPSET_LISTS="ssh_allow ipaudio"

# File to store last known IP (relative to script dir or absolute; name e.g. old_ip_<DNS_RECORD with _ for .>)
OLD_IP_FILE="./old_ip_example_example_com"

# Ipset config path (where ipset save writes; relative to script dir or absolute)
IPSET_CONF="./ipset.conf"


# --- add_ip_to_nginx.sh ---

# Log file path (relative to script dir or absolute)
NGINX_LOGFILE="./nginx_update.log"

# Marker in include-файле: строка вида allow 1.2.3.4; #SYSADMIN (подставляется новый IP)
NGINX_ALLOW_MARKER="#SYSADMIN"

# Директория с include-файлами (подключаются в location через include path.conf;)
# В каждом файле — строка allow IP; #SYSADMIN (и при необходимости deny all;)
NGINX_IP_ALLOW_DIR="/etc/nginx/ip-allow"
