# Before first run execute: ./deploy.sh (or sudo ./deploy.sh to create ipset sets)
#
# --- Common (used by both scripts) ---

# DNS name to resolve (host to track)
DNS_RECORD="example.example.com"

# Host name for logs and notifications (e.g. Telegram)
host="my-server"

# Full path to message script (e.g. Telegram)
TGBOT="/usr/local/bin/send_tg.sh"

# --- send_tg.sh (Telegram) ---

# Telegram bot token (from @BotFather)
TG_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Telegram chat ID (where to send messages)
TG_CHAT_ID="-1001234567890"

# --- add_ip_to_ipset.sh ---

# Log file path
IPSET_LOGFILE="/var/log/scripts/ipset_update.log"

# Ipset set names, space-separated (e.g. ssh_allow ipaudio)
IPSET_LISTS="ssh_allow ipaudio"

# File to store last known IP (full path; name e.g. old_ip_<DNS_RECORD with _ for .>)
OLD_IP_FILE="/usr/local/bin/old_ip_example_example_com"

# Ipset config path (where ipset save writes)
IPSET_CONF="/etc/iptables/ipset.conf"


# --- add_ip_to_nginx.sh ---

# Log file path
NGINX_LOGFILE="/var/log/scripts/nginx_update.log"

# Marker in nginx config: line with this comment holds allow IP (e.g. allow 1.2.3.4; # SYSADMIN)
NGINX_ALLOW_MARKER="#SYSADMIN"

# Mode 1: scan all configs in this directory
NGINX_SITES_AVAILABLE="/etc/nginx/sites-available"

# Mode 2: single config (uncomment and comment NGINX_SITES_AVAILABLE if needed)
# nginx_conf="/etc/nginx/sites-available/my-server"
